<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.master.cs" Inherits="Demo2.Site1" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Demo2</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { min-height: 100vh; display: flex; flex-direction: column; background: #f0f2f5; }
        .container { flex: 1; padding: 30px 0; }
        footer { background: #343a40; color: white; padding: 15px 0; margin-top: auto; }
        .card { max-width: 500px; margin: auto; box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
    </style>
</head>
<body>
    <form id="form1" runat="server">
        <!-- Header -->
        <nav class="navbar navbar-dark bg-dark">
            <div class="container">
                <span class="navbar-brand">Demo2</span>
                <div>
                    <a href="Login.aspx" class="btn btn-outline-light btn-sm">Login</a>
                    <a href="Register.aspx" class="btn btn-outline-light btn-sm">Register</a>
                </div>
            </div>
        </nav>

        <!-- Main Content -->
        <div class="container">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
                <!-- Default content -->
            </asp:ContentPlaceHolder>
        </div>

        <!-- Footer -->
        <footer>
            <div class="container text-center">
                &copy; 2026 Demo2 - All Rights Reserved
            </div>
        </footer>
    </form>
</body>
</html>